
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id String @id 
  username String @unique
}

model Department {
   id Int @id @default(autoincrement())
   name String @unique
   lecturers Lecturer[]
   students Student[]
   subjects Subject[]
}


model LectureRoom {
  id Int @id @default(autoincrement())
  name String
  maxCapacity Int

  reservations Reservation[]
}

model AcademicYear {
  id Int @id @default(autoincrement())
  name String @unique
  students Student[]
}

model Student {
  id String @id
  username String @unique
  name String
  surname String
  email String? @unique
  phone String? @unique
  sex UserSex
  yearSem Int @default(11) 
  createdAt DateTime @default(now())

  academicYearId Int
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  subjects Subject[]

  departmentId Int
  department Department @relation(fields: [departmentId], references: [id])
}



model Lecturer {
  id String @id
  username String @unique

  title LecturerTitle @default(Mr) 
  name String
  surname String
  email String? @unique
  phone String @unique
  sex UserSex
  createdAt DateTime @default(now())
  subjects Subject[]
  reservations Reservation[]

  departmentId Int
  department Department @relation(fields: [departmentId], references: [id])
}

model Subject {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  name         String
  credit       Int
  yearSem      Int? 
  lecturers    Lecturer[]
  students     Student[]
  reservations Reservation[]

  departmentId Int?         
  department   Department?  @relation(fields: [departmentId], references: [id])
}


model Reservation {
  id Int @id @default(autoincrement())
  startTime DateTime
  endTime DateTime
  createdAt DateTime @default(now())

  lecRoomId Int
  lectureRoom LectureRoom @relation(fields: [lecRoomId], references: [id])

  lecturerId String
  lecturer Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  subjectId Int
  subject Subject @relation(fields: [subjectId], references: [id])
}

enum UserSex {
  MALE
  FEMALE
}

enum LecturerTitle {
 Prof
 Dr
 Mr
 Mrs
 Ms
}

